# Local stand (Windows): setup.bat once, then run.bat
# Local stand (Git Bash): ./setup.sh once, then ./run.sh
# Unix with make: make venv && make run
# Copy this file to src/.env and fill secrets.

DEBUG=1

OPENAI_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_OPENAI_MODEL=gpt-5-mini

# 0 = не вызывать OpenAI на прогоне (безопасно для первого стенда)
ENABLE_CLASSIFICATION=0

POLLING_INTERVAL=1800  # in seconds
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHANNEL_ID=123456789

SEND_DEBUG_INFO=1
SEND_SKIPPED_ORDERS=1
SEND_LLM_SKIPPED_ORDERS=1

# --- Anthropic (фаза 2–3) ---
# Ключ: https://console.anthropic.com/ (trial ~$5, карта часто не нужна)
ANTHROPIC_API_KEY=

# Sonnet; актуальный ID — в Console -> Models
DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Smoke (фаза 2): один короткий вызов вне пайплайна
ANTHROPIC_MAX_TOKENS=64

# Финальная LLM: при ENABLE_FINAL_LLM=1 для первых FINAL_LLM_MAX_ORDERS кандидатов
# выполняется scrape страницы заказа + вызов evaluate_order (final_response).
ENABLE_FINAL_LLM=0
FINAL_LLM_MAX_ORDERS=1
# FINAL_LLM_MAX_TOKENS — не используется; см. FINAL_RESPONSE_MAX_TOKENS ниже
FINAL_LLM_MAX_TOKENS=512
# ORDER_ATTACHMENTS_DIR=staticfiles/fl/attachments

# --- Final response module (isolated LLM) ---
# mock = без API; yandex = Yandex Cloud Foundation Models
FINAL_RESPONSE_PROVIDER=mock
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest
FINAL_RESPONSE_MAX_TOKENS=512
