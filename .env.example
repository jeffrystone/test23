email=user@example.com
password=your_password

# AI provider: mock | yandex | claude (--mode перекрывает это значение)
AI_MODE=mock
AI_MAX_TOKENS=512

# Yandex Cloud
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Vacancy: путь к файлу резюме (.pdf, .doc, .docx, …)
# Если не задан — отклик только текстом (remove_resume: 1)
FL_RESUME_PATH=
